# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Environment / secrets
.env
.env.*

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/

# Local profiler / Instruments-style process sampling dumps
stack.txt
python_stack.txt
*_stack.txt
*.stackshot
sample.txt

# Serving / Docker freeze bundle (tracked, including the small V1 .joblib)
# See artifacts/v1/README.md — do not ignore artifacts/**/*.joblib

# Dataset — raw PCAPs are large local-only source data (see README)
data/raw/

# Audit — ephemeral resume checkpoints and local run logs
data/audit/.work/
data/audit/*.log

# Future pipeline outputs
data/processed/
data/windows/

# Experiment manifests (JSON/CSV) are trackable; ignore heavy run outputs
data/experiments/**
!data/experiments/
!data/experiments/**
!data/experiments/**/*.json
!data/experiments/**/*.csv
data/experiments/**/*.parquet
data/experiments/**/*.parquet.tmp
data/experiments/**/*.joblib
data/experiments/**/*.npz
data/experiments/**/models/
data/experiments/**/predictions/
data/experiments/**/.work/
data/experiments/**/*.log


# Feature builds are heavy; keep characterization / V1 schema / smoke trackable
data/features/**
!data/features/
!data/features/windowing_characterization*.csv
!data/features/v1/
!data/features/v1/**
!data/features/v1/**/*.json
!data/features/v1/**/*.csv
# Still ignore heavy parquet / full builds under v1 if added later
data/features/v1/**/*.parquet
data/features/v1/**/*.parquet.tmp
data/features/v1/.work/
# Modeling manifests (CSV/JSON) are trackable; ignore future heavy sample views
data/modeling/**
!data/modeling/
!data/modeling/v1/
!data/modeling/v1/**
!data/modeling/v1/**/*.json
!data/modeling/v1/**/*.csv
data/modeling/v1/**/*.parquet
data/modeling/v1/**/*.parquet.tmp
data/modeling/v1/**/*.joblib
data/modeling/v1/**/*.npz
data/modeling/v1/baselines/**/models/
data/modeling/v1/baselines/**/predictions/
data/modeling/v1/.work/
